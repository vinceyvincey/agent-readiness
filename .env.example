# Example environment variables for agent-readiness.
# No secrets are required to run the deterministic engine (node --experimental-strip-types src/cli.ts <repo>).
# These are provided for reproducibility and non-default behavior.

# Log verbosity (debug|info|warn|error). Optional.
LOG_LEVEL=info

# Set to 1 to skip writing .agent-readiness/ report artifacts (read-only mode).
# READ_ONLY=0
